# Provider Configuration (openai | custom | gemini | anthropic | ollama | openrouter)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# API Keys (fill the one matching your selected provider)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Base URLs (for custom / ollama)
CUSTOM_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434

# Memory Configuration Knobs
COMPACT_THRESHOLD_TOKENS=700
COMPACT_KEEP_MESSAGES=4
